<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180dp banner shown on the Android TV home screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#FF1E1B4B" android:endColor="#FF4F46E5" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:gravity="center" android:width="96dp" android:height="96dp" android:drawable="@mipmap/ic_launcher" />
</layer-list>
